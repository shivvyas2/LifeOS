<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array><string>group.com.shivvyas.lifeos</string></array>
	<!-- Read access to Apple Health. This is the whole requirement for steps,
	     sleep, weight and heart data.

	     Three keys Xcode's capability editor added have been removed on purpose:

	     com.apple.developer.healthkit.access = health-records asks for CLINICAL
	     records, lab results and medications from a healthcare provider. It
	     needs a separate entitlement Apple has to approve, and shipping it
	     unapproved fails provisioning and submission. Nothing here reads them.

	     background-delivery wakes the app when Health gets new samples. Real,
	     but nothing registers an HKObserverQuery yet, so it would be an
	     entitlement claimed and unused. Add it back with the code that needs it.

	     recalibrate-estimates is for correcting VO2 max and cardio fitness
	     estimates. Not something this app does. -->
	<key>com.apple.developer.healthkit</key>
	<true/>

	<!-- Push, for the proactive nudge. Claimed here because the code that
	     needs it ships alongside: PushService registers a token, device_tokens
	     stores it, and lifo-nudge sends to it.

	     development, not production. The value has to match the provisioning
	     the build is signed with, and a development build talking to the
	     production APNs host is 400 BadDeviceToken on every send. Xcode
	     rewrites this for a distribution build; APNS_SANDBOX on the Edge
	     Function picks the matching host. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- The domain that owns the Plaid OAuth redirect.

	     Banks like Chase do not take a login inside Plaid Link. Link sends the
	     user to the bank, and the bank sends the browser to a redirect URI
	     registered with Plaid in advance. A custom scheme cannot be registered
	     there and would not survive the hop through Safari, so the redirect is
	     an https universal link and this entitlement is what makes iOS hand it
	     to the app instead of opening it in Safari.

	     The matching claim is served from web/, at
	     https://almanac.shivvyas.com/.well-known/apple-app-site-association.
	     Both sides have to name the same domain or the redirect silently opens
	     in Safari and the connection is abandoned half finished. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:almanac.shivvyas.com</string>
	</array>
	<!-- Weather on the day screen. Apple documents this key as a Boolean, and
	     a profile regenerated with WeatherKit on refuses any other shape. The
	     capability on the App ID is the owner's step in the portal. -->
	<key>com.apple.developer.weatherkit</key>
	<true/>
</dict>
</plist>
