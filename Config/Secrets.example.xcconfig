// Copy to Config/Secrets.xcconfig and fill in. That file is gitignored.
//
// None of these are true secrets. The Supabase anon key is designed to ship in
// clients and is safe because Row Level Security gates every row. The Whoop
// client ID is public by OAuth design.
//
// Real secrets (service_role key, WHOOP_CLIENT_SECRET, ANTHROPIC_API_KEY)
// live ONLY in Supabase Edge Function environments. Never add them here.

SUPABASE_URL      =
SUPABASE_ANON_KEY =
WHOOP_CLIENT_ID   =
// NOTE: '//' starts a comment in xcconfig, so the scheme separator
// must be broken up with $() or the value truncates to 'lifeos:'.
WHOOP_REDIRECT_URI = https:/$()/<your-project>.supabase.co/functions/v1/whoop-callback

// Fitbit. The client ID is public by OAuth design; FITBIT_CLIENT_SECRET is a
// real secret and lives ONLY in the Edge Function environment.
//
// Fitbit permits a custom scheme for a native app, so this points straight at
// the app and needs no bridge function. The same '//' comment trap applies.
FITBIT_CLIENT_ID   =
FITBIT_REDIRECT_URI = lifeos:/$()/fitbit-callback

// Speech: local ElevenLabs key. Copy the real value into Secrets.xcconfig only.
// That file is gitignored. Never commit a live key, never log it.
ELEVENLABS_API_KEY =
