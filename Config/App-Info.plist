<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app uses only standard HTTPS. That is exempt encryption, and saying
	     so here stops App Store Connect prompting on every TestFlight upload.
	     Xcode's capability editor dropped this key when it rewrote the file. -->
	<!-- remote-notification, so a nudge that arrives while the app is
	     backgrounded is delivered to the delegate rather than only shown.
	     Claimed with the code that uses it, like the HealthKit keys. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>bluetooth-central</string>
	</array>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Almanac connects to your chosen heart-rate sensor, including WHOOP Heart Rate Broadcast, to show live beats during an activity.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Two schemes, and the app answers to both.
	     `almanac` is the one to keep: it is the app's own name and nothing else
	     claims it. `lifeos` stays because the redirect bridge still sends it,
	     and because a build in the wild that only knows `lifeos` must keep
	     working while it is still installed.
	     Declaring both is what removes the lockstep: the bridge can be pointed
	     at either scheme, at any time, without the app and the server having to
	     ship together. See `AppConfig.appURLSchemes`. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.shivvyas.almanac.whoop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>almanac</string>
				<string>lifeos</string>
			</array>
		</dict>
	</array>
	<key>ElevenLabsAPIKey</key>
	<string>$(ELEVENLABS_API_KEY)</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>Almanac shows your day's schedule on Today and lets the assistant create and change events for you.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>LifeOS uses your location for the weather on your day screen.</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SupabaseURL</key>
	<string>$(SUPABASE_URL)</string>
	<key>WHOOPClientID</key>
	<string>$(WHOOP_CLIENT_ID)</string>
	<key>WhoopRedirectURI</key>
	<string>$(WHOOP_REDIRECT_URI)</string>
	<key>PlaidRedirectURI</key>
	<string>$(PLAID_REDIRECT_URI)</string>
	<key>FitbitClientID</key>
	<string>$(FITBIT_CLIENT_ID)</string>
	<key>FitbitRedirectURI</key>
	<string>$(FITBIT_REDIRECT_URI)</string>
	<key>GitHubClientID</key>
	<string>$(GITHUB_CLIENT_ID)</string>
	<key>GoogleClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>googlegmail</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
